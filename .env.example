# Porta em que a API vai escutar localmente
PORT=3000

# URL(s) do frontend permitidas pelo CORS. Aceita múltiplas, separadas por vírgula.
# Padrão: http://localhost:5173 (porta padrão do Vite)
FRONTEND_URL=http://localhost:5173

# URL do projeto Supabase - usada para buscar o JWKS público e validar o JWT.
# Encontrada em Project Settings > API > Project URL.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Conexão via pooler (PgBouncer) do Supabase - usada pela aplicação em runtime.
# Porta 6543, com pgbouncer=true.
DATABASE_URL="postgresql://postgres:[SUA-SENHA]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta ao Postgres do Supabase - usada só pelo Prisma Migrate.
# Porta 5432, sem pgbouncer.
DIRECT_URL="postgresql://postgres:[SUA-SENHA]@[PROJECT-REF].supabase.co:5432/postgres"

# Chave da API do TMDB (v3, gratuita) - usada para buscar nome/poster das séries.
# Criada em https://www.themoviedb.org/settings/api
TMDB_API_KEY=
