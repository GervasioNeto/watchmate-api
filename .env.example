# Porta em que a API vai escutar localmente
PORT=3000

# URL(s) do frontend permitidas pelo CORS. Aceita múltiplas, separadas por vírgula.
# Padrão: http://localhost:5173 (porta padrão do Vite)
FRONTEND_URL=http://localhost:5173

# URL do projeto Supabase - usada para buscar o JWKS público e validar o JWT.
# Encontrada em Project Settings > API > Project URL.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Conexão via pooler (PgBouncer) do Supabase - usada pela aplicação em runtime.
# Porta 6543, com pgbouncer=true.
DATABASE_URL="postgresql://postgres:[SUA-SENHA]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta ao Postgres do Supabase - usada só pelo Prisma Migrate.
# Porta 5432, sem pgbouncer.
DIRECT_URL="postgresql://postgres:[SUA-SENHA]@[PROJECT-REF].supabase.co:5432/postgres"

# Chave da API do TMDB (v3, gratuita) - usada para buscar nome/poster das séries.
# Criada em https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Bot do Telegram: avisos para o par (série adicionada, episódio visto). Sem token, a API
# funciona normalmente, só sem o bot. Use um bot diferente por ambiente que roda ao mesmo
# tempo (sua máquina, develop, main). Token e usuário (sem @) vêm do @BotFather:
# /mybots > o bot > API Token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Só no servidor publicado. Com o segredo, o Telegram entrega as mensagens no webhook
# (POST /telegram/webhook); sem ele, o bot busca as mensagens por polling (bom para rodar
# na sua máquina). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Endereço público da API, para registrar o webhook. No Render não precisa: ele já
# informa o próprio endereço (RENDER_EXTERNAL_URL).
API_PUBLIC_URL=

# Endereço público do app, para o botão "Ver no WatchMate" dos avisos. Sem ele, vale o
# primeiro de FRONTEND_URL; endereços locais ficam sem botão (o Telegram não abre).
APP_URL=

# Avisos por push no app (chegam na tela de bloqueio, com o app fechado). Sem as três, a
# API funciona normalmente, só sem push. Use um par de chaves por ambiente que roda ao mesmo
# tempo (sua máquina, develop, main): cada um só manda para os aparelhos inscritos com a sua.
# Gere o par com:
#   npx web-push generate-vapid-keys
# O contato (VAPID_SUBJECT) é o endereço do app ou um mailto:, e vai para os serviços de push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://watchmate-for-two.vercel.app

# Só para testar sem o par: os avisos vão também para quem fez a ação.
NOTIFY_SELF=false
