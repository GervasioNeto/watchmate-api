generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// O id espelha o auth.users.id do Supabase Auth (não é gerado pelo Prisma).
// A linha em "usuarios" é criada pela aplicação após o cadastro no Supabase.
model Usuario {
  id            String   @id @db.Uuid
  email         String   @unique
  nome          String?
  avatarEstilo  String?  @map("avatar_estilo")
  avatarSemente String?  @map("avatar_semente")
  criadoEm      DateTime @default(now()) @map("criado_em")
  // Avisos no Telegram (ver src/telegram). O id da conversa com o bot fica como texto:
  // ids do Telegram passam do limite de Int. Os três campos ficam fora das consultas
  // por padrão (ver lib/prisma.ts), para não saírem nas rotas que devolvem o usuário.
  telegramChatId   String?  @unique @map("telegram_chat_id")
  telegramUsername String?  @map("telegram_username")
  // Ligado pela pessoa no perfil; desligado pelo /parar ou quando ela bloqueia o bot.
  avisosTelegram   Boolean  @default(false) @map("avisos_telegram")
  // A última vez que a pessoa abriu "Entre vocês": os avisos depois disso contam como
  // novos (o pontinho no ícone). Um horário só, em vez de um "lido" por aviso.
  avisosVistosEm   DateTime? @map("avisos_vistos_em")

  membroDoGrupo       MembroDoGrupo?
  progressoEpisodios  ProgressoEpisodio[]  @relation("ProgressoDoUsuario")
  episodiosMarcados   ProgressoEpisodio[]  @relation("EpisodioMarcadoPor")
  seriesAdicionadas   SerieAcompanhada[]   @relation("SerieAdicionadaPor")
  reacoesEpisodio     ReacaoEpisodio[]
  comentariosEpisodio ComentarioEpisodio[]
  interessesSerie     InteresseSerie[]
  codigosTelegram     CodigoTelegram[]
  inscricoesPush      InscricaoPush[]
  convitesFeitos      ConviteSessao[]      @relation("ConviteDe")
  convitesRecebidos   ConviteSessao[]      @relation("ConvitePara")
  avisosRecebidos     Aviso[]              @relation("AvisoPara")
  avisosFeitos        Aviso[]              @relation("AvisoDe")

  @@map("usuarios")
}

model Grupo {
  id            String   @id @default(uuid()) @db.Uuid
  nome          String   @default("Nosso Grupo")
  codigoConvite String   @unique @map("codigo_convite")
  criadoEm      DateTime @default(now()) @map("criado_em")

  membros            MembroDoGrupo[]
  seriesAcompanhadas SerieAcompanhada[]
  convites           ConviteSessao[]

  @@map("grupos")
}

// Um usuário pertence a no máximo um grupo por vez (usuarioId é @unique).
// O limite de 2 membros por grupo é validado na aplicação, não no banco.
model MembroDoGrupo {
  id        String    @id @default(uuid()) @db.Uuid
  grupoId   String    @map("grupo_id") @db.Uuid
  usuarioId String    @unique @map("usuario_id") @db.Uuid
  entrouEm  DateTime  @default(now()) @map("entrou_em")
  // Recado curto que o membro deixa para o par, visível para o grupo. Fica no
  // membro (e não no usuário) porque só faz sentido dentro do grupo: sai junto.
  recado    String?
  recadoEm  DateTime? @map("recado_em")
  // A cor da pessoa na dupla, um id da paleta (ver lib/personColors.ts). Fica no membro
  // pelo mesmo motivo do recado, e o índice único garante que os dois nunca tenham a
  // mesma cor no grupo. Quem cria o grupo e quem entra recebem uma cor livre na hora.
  // Opcional só no banco: uma versão anterior da API, rodando contra o mesmo banco
  // durante um deploy, cria membros sem cor (o app mostra a cor padrão para eles).
  cor       String?

  grupo   Grupo   @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([grupoId, cor])
  @@map("membros_do_grupo")
}

// Define o comportamento padrão ao marcar um episódio: JUNTOS marca para todos os
// membros do grupo; SEPARADOS marca só para quem clicou. Dá pra sobrescrever por
// requisição via `scope`.
enum ModoAcompanhamento {
  JUNTOS
  SEPARADOS
}

model SerieAcompanhada {
  id                 String             @id @default(uuid()) @db.Uuid
  grupoId            String             @map("grupo_id") @db.Uuid
  modo               ModoAcompanhamento @default(JUNTOS)
  tmdbId             Int       @map("tmdb_id")
  nome               String
  posterPath         String?   @map("poster_path")
  // Snapshot do TMDB: [{ numero: number, totalEpisodios: number }]. A lista renova o
  // snapshot das séries no ar (ver lib/seriesSnapshot.ts), então temporadas e episódios
  // novos aparecem sozinhos.
  temporadas         Json
  sinopse            String?   @map("sinopse")
  notaMedia          Float?    @map("nota_media")
  status             String?   @map("status")
  backdropPath       String?   @map("backdrop_path")
  generos            String[]  @map("generos")
  primeiraExibicaoEm DateTime? @map("primeira_exibicao_em")
  idiomaOriginal     String?   @map("idioma_original")
  nomeOriginal       String?   @map("nome_original")
  englishName        String?   @map("english_name")
  // Último episódio que foi ao ar e o próximo agendado, do snapshot do TMDB:
  // { temporada: number, episodio: number, dataExibicao: string | null }, com a data só
  // do dia ('2026-10-16'). Null quando o TMDB não informa (série que acabou não tem próximo).
  ultimoEpisodioExibido Json?  @map("ultimo_episodio_exibido")
  proximoEpisodio    Json?     @map("proximo_episodio")
  // Quando o snapshot foi renovado pela última vez; null nas séries adicionadas antes disso.
  atualizadoTmdbEm   DateTime? @map("atualizado_tmdb_em")
  adicionadoPor      String?   @map("adicionado_por") @db.Uuid
  adicionadoEm       DateTime  @default(now()) @map("adicionado_em")

  grupo                Grupo                @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  adicionadoPorUsuario Usuario?             @relation("SerieAdicionadaPor", fields: [adicionadoPor], references: [id], onDelete: SetNull)
  progressoEpisodios   ProgressoEpisodio[]
  reacoesEpisodio      ReacaoEpisodio[]
  comentariosEpisodio  ComentarioEpisodio[]
  interesses           InteresseSerie[]
  convites             ConviteSessao[]
  avisos               Aviso[]

  @@unique([grupoId, tmdbId])
  @@map("series_acompanhadas")
}

// Progresso individual: uma linha por pessoa por episódio assistido.
// Desmarcar apaga a linha. O "progresso em comum" é a interseção entre os membros.
model ProgressoEpisodio {
  id                 String   @id @default(uuid()) @db.Uuid
  serieAcompanhadaId String   @map("serie_acompanhada_id") @db.Uuid
  temporada          Int
  episodio           Int
  // Dono do progresso (quem assistiu).
  usuarioId          String   @map("usuario_id") @db.Uuid
  assistidoEm        DateTime @map("assistido_em")
  // Quem registrou - pode ser o parceiro, ao marcar "assistimos juntos".
  marcadoPor         String?  @map("marcado_por") @db.Uuid
  // true quando foi marcado para o grupo todo de uma vez (assistiram juntos).
  juntos             Boolean  @default(false)

  serieAcompanhada  SerieAcompanhada @relation(fields: [serieAcompanhadaId], references: [id], onDelete: Cascade)
  usuario           Usuario          @relation("ProgressoDoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  marcadoPorUsuario Usuario?         @relation("EpisodioMarcadoPor", fields: [marcadoPor], references: [id], onDelete: SetNull)

  @@unique([serieAcompanhadaId, usuarioId, temporada, episodio])
  @@map("progresso_episodios")
}

// Uma reação por pessoa por episódio - pode ser trocada (upsert), não empilha.
model ReacaoEpisodio {
  id                 String   @id @default(uuid()) @db.Uuid
  serieAcompanhadaId String   @map("serie_acompanhada_id") @db.Uuid
  temporada          Int
  episodio           Int
  usuarioId          String   @map("usuario_id") @db.Uuid
  emoji              String
  criadoEm           DateTime @default(now()) @map("criado_em")
  atualizadoEm       DateTime @updatedAt @map("atualizado_em")

  serieAcompanhada SerieAcompanhada @relation(fields: [serieAcompanhadaId], references: [id], onDelete: Cascade)
  usuario          Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([serieAcompanhadaId, temporada, episodio, usuarioId])
  @@map("reacoes_episodio")
}

// Comentários livres por episódio - vários por pessoa, em ordem cronológica.
model ComentarioEpisodio {
  id                 String   @id @default(uuid()) @db.Uuid
  serieAcompanhadaId String   @map("serie_acompanhada_id") @db.Uuid
  temporada          Int
  episodio           Int
  usuarioId          String   @map("usuario_id") @db.Uuid
  texto              String
  criadoEm           DateTime @default(now()) @map("criado_em")

  serieAcompanhada SerieAcompanhada @relation(fields: [serieAcompanhadaId], references: [id], onDelete: Cascade)
  usuario          Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("comentarios_episodio")
}

// "Quero ver": cada membro marca as séries da fila que quer começar. Uma linha por pessoa
// por série; desmarcar apaga. A marcação continua depois que a série começa (o app só a
// mostra enquanto ninguém começou) e volta a valer se o progresso for desfeito.
model InteresseSerie {
  id                 String   @id @default(uuid()) @db.Uuid
  serieAcompanhadaId String   @map("serie_acompanhada_id") @db.Uuid
  usuarioId          String   @map("usuario_id") @db.Uuid
  criadoEm           DateTime @default(now()) @map("criado_em")

  serieAcompanhada SerieAcompanhada @relation(fields: [serieAcompanhadaId], references: [id], onDelete: Cascade)
  usuario          Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([serieAcompanhadaId, usuarioId])
  @@map("interesses_serie")
}

// Código de uso único que liga a conta ao Telegram: o app gera, o link do bot leva
// (t.me/<bot>?start=<codigo>) e o /start confere. Vale por poucos minutos.
model CodigoTelegram {
  codigo    String   @id
  usuarioId String   @map("usuario_id") @db.Uuid
  expiraEm  DateTime @map("expira_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("codigos_telegram")
}

// Um aparelho que aceitou receber avisos por push (ver src/push). A mesma pessoa pode ter
// vários (o celular e o computador), e cada um liga e desliga o seu. O endpoint é o endereço
// do aparelho no serviço de push do navegador: único, e é por ele que a inscrição se atualiza.
model InscricaoPush {
  id         String   @id @default(uuid()) @db.Uuid
  usuarioId  String   @map("usuario_id") @db.Uuid
  endpoint   String   @unique
  // As chaves do aparelho para criptografar o aviso: só ele consegue ler o conteúdo.
  p256dh     String
  auth       String
  // A chave pública VAPID do ambiente em que o aparelho se inscreveu. O banco é o mesmo para
  // a sua máquina, a develop e a main, e cada ambiente tem as suas chaves: cada um só manda
  // para as inscrições feitas com a própria chave.
  chaveVapid String   @map("chave_vapid")
  criadoEm   DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("inscricoes_push")
}

// O "Bora?": um chama o outro para ver um episódio, agora ou num horário (ver src/invites).
// Um convite ativo por dupla: um novo substitui o anterior. Expirar não é um status
// guardado: passou de `expiraEm` sem ter sido cumprido, a API devolve como expirado.
enum StatusConvite {
  PENDENTE
  ACEITO
  RECUSADO
  CANCELADO
}

model ConviteSessao {
  id                 String        @id @default(uuid()) @db.Uuid
  grupoId            String        @map("grupo_id") @db.Uuid
  serieAcompanhadaId String        @map("serie_acompanhada_id") @db.Uuid
  temporada          Int
  episodio           Int
  deUsuarioId        String        @map("de_usuario_id") @db.Uuid
  paraUsuarioId      String        @map("para_usuario_id") @db.Uuid
  // Para quando é a sessão; null é "agora".
  horario            DateTime?
  // O fuso de quem chamou (ex.: "America/Sao_Paulo"), para os avisos dizerem "hoje às 21h"
  // na hora de vocês, e não na do servidor.
  fusoHorario        String        @map("fuso_horario")
  // Uma das frases prontas do app (ver src/invites/phrases.ts), ou nenhuma.
  frase              String?
  status             StatusConvite @default(PENDENTE)
  // Aceito em outro horário ("topo, mas às 22h"): `horario` já é o novo.
  remarcado          Boolean       @default(false)
  respondidoEm       DateTime?     @map("respondido_em")
  expiraEm           DateTime      @map("expira_em")
  criadoEm           DateTime      @default(now()) @map("criado_em")

  grupo            Grupo            @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  serieAcompanhada SerieAcompanhada @relation(fields: [serieAcompanhadaId], references: [id], onDelete: Cascade)
  de               Usuario          @relation("ConviteDe", fields: [deUsuarioId], references: [id], onDelete: Cascade)
  para             Usuario          @relation("ConvitePara", fields: [paraUsuarioId], references: [id], onDelete: Cascade)
  avisos           Aviso[]

  @@index([grupoId, criadoEm])
  @@map("convites_sessao")
}

// "Entre vocês": tudo o que o par fez para você, guardado (ver src/inbox). O push é só uma
// cópia que tenta chegar no celular; apagou o push, o aviso continua aqui. Fica 30 dias.
enum TipoAviso {
  CONVITE
  RESPOSTA_CONVITE
  RECADO
  COMENTARIO
  REACAO
  SERIE_ADICIONADA
  EPISODIO_VISTO
  TEMPORADA_TERMINADA
}

model Aviso {
  id                 String    @id @default(uuid()) @db.Uuid
  // Para quem é o aviso, e quem fez.
  usuarioId          String    @map("usuario_id") @db.Uuid
  autorId            String    @map("autor_id") @db.Uuid
  tipo               TipoAviso
  // Avisos do mesmo assunto em pouco tempo viram um só, que sobe com o mais recente
  // ("Leila comentou 3 vezes no T2 · E5"). `quantidade` conta quantos se juntaram.
  assunto            String
  quantidade         Int       @default(1)
  serieAcompanhadaId String?   @map("serie_acompanhada_id") @db.Uuid
  temporada          Int?
  episodio           Int?
  conviteId          String?   @map("convite_id") @db.Uuid
  // Só o recado guarda o texto (é o recado daquela hora). Comentário e reação são lidos na
  // hora de mostrar: um comentário apagado some daqui, e o spoiler segue o que você já viu.
  texto              String?
  criadoEm           DateTime  @default(now()) @map("criado_em")
  atualizadoEm       DateTime  @default(now()) @map("atualizado_em")

  usuario          Usuario           @relation("AvisoPara", fields: [usuarioId], references: [id], onDelete: Cascade)
  autor            Usuario           @relation("AvisoDe", fields: [autorId], references: [id], onDelete: Cascade)
  serieAcompanhada SerieAcompanhada? @relation(fields: [serieAcompanhadaId], references: [id], onDelete: Cascade)
  convite          ConviteSessao?    @relation(fields: [conviteId], references: [id], onDelete: Cascade)

  @@index([usuarioId, atualizadoEm])
  @@map("avisos")
}
